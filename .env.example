# Copia este archivo a .env y ajusta los valores antes de levantar docker-compose.
# IMPORTANTE: los secretos son OBLIGATORIOS y se validan al arrancar. La app NO
# inicia si falta alguno o si es débil (JWT/HUELLA < 32 chars, JOBS < 16 chars,
# AES que no decodifique a 32 bytes). Genera valores reales de una vez con:
#   python -c "import secrets,base64; \
#     print('JWT_SECRET='+secrets.token_urlsafe(48)); \
#     print('HUELLA_SECRET='+secrets.token_urlsafe(32)); \
#     print('JOBS_SECRET='+secrets.token_urlsafe(24)); \
#     print('AES_KEY_B64='+base64.b64encode(secrets.token_bytes(32)).decode())"

DATABASE_URL=postgresql+psycopg2://campanas:campanas@db:5432/campanas

# JWT (autenticación) — JWT_SECRET obligatorio, mínimo 32 caracteres aleatorios.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Cifrado AES-GCM de credenciales de cuentas publicitarias.
# Clave de 32 bytes en base64 (AES-256). Obligatoria.
AES_KEY_B64=

# Secreto para la huella (HMAC) de unicidad de cuentas publicitarias.
# Obligatorio, mínimo 32 caracteres aleatorios.
HUELLA_SECRET=

# Secreto para disparar jobs programados desde un cron externo (ver
# "Desplegar en Render" en COMO_EJECUTAR.md). Obligatorio, mínimo 16
# caracteres; nunca reusar entre ambientes.
JOBS_SECRET=

# Orígenes permitidos por CORS, separados por coma. En desarrollo déjalo
# como está; en producción pon el dominio real (https://tudominio.com).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AGENCIA_NOMBRE=INNquietus

# Sembrado de datos de prueba al iniciar el contenedor (solo desarrollo).
SEED_ON_START=false
FORCE_SEED=false

TZ=America/Mexico_City
