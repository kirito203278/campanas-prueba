# Copia este archivo a .env y ajusta los valores antes de levantar docker-compose.

DATABASE_URL=postgresql+psycopg2://campanas:campanas@db:5432/campanas

# JWT (autenticación)
JWT_SECRET=cambia-esto-por-un-valor-aleatorio-largo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Cifrado AES-GCM de credenciales de cuentas publicitarias.
# Genera una clave de 32 bytes en base64 con:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
AES_KEY_B64=

# Secreto para la huella (HMAC) de unicidad de cuentas publicitarias.
HUELLA_SECRET=cambia-esto-tambien-por-un-valor-aleatorio-largo

# Secreto para disparar jobs programados desde un cron externo (ver
# "Desplegar en Render" en COMO_EJECUTAR.md). Mismo tipo de valor que los de
# arriba, nunca reusar entre ambientes.
JOBS_SECRET=cambia-esto-tambien-por-un-valor-aleatorio-largo

# Orígenes permitidos por CORS, separados por coma. En desarrollo déjalo
# como está; en producción pon el dominio real (https://tudominio.com).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AGENCIA_NOMBRE=INNquietus

# Sembrado de datos de prueba al iniciar el contenedor (solo desarrollo).
SEED_ON_START=false
FORCE_SEED=false

TZ=America/Mexico_City
